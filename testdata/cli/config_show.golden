active_cartridge            claude      global
cartridges.claude.model     fable       global
cartridges.claude.command   claude      global
ammo                        12          repo
safety                      false       repo
vibes                       []          default
rules                       []          default
exclude                     []          default
check_command               make check  repo
idle_replan_interval        10m         default
gate_poll_interval          1m          default
pr_poll_interval            1m          default
graph_poll_interval         2s          default
max_diff_bytes              204800      default
re_review_threshold         0.4         default
max_beads_per_plan          8           default
limits.max_review_rounds    3           repo
limits.max_pushback_rounds  2           default
limits.max_conflict_rounds  3           default
limits.agent_timeout        30m         default
limits.max_tokens           0           default
limits.max_cost_usd         0           default
limits.max_plan_rejections  2           default
limits.max_plan_failures    5           default
roles.po.cartridge                      default
roles.engineer.cartridge                default
